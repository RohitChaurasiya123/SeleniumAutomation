<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="FailedTestsParallelSuite"  parallel="tests"  thread-count="2">

<listeners>
    <listener class-name="utilities.ExtentReportManager"/>
</listeners>

    <test name="FailedTests_Chrome">
        <parameter name="os" value="windows"/>
        <parameter name="browser" value="chrome"/>
       <classes>
            <class name="testCases.SignInPageTest"/>
            <class name="testCases.SignupPageTest"/>   
        </classes>        
    </test>

    <test name="FailedTests_Edge">
        <parameter name="os" value="windows"/>
        <parameter name="browser" value="edge"/>
       <classes>
            <class name="testCases.EndToEndBuyAProductTest"/>
            <class name="testCases.HomePageTest"/>        
        </classes>
    </test>

</suite>